# Virtual Environment (libraries installed on your machine)
.venv/
venv/
env/
.env

# Python compilation cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Local raw datasets (too large for git)
data/raw/
data/ptbxl/
data/cohort/

# Track sample records, ignore other local sample scratch
data/samples/*
!data/samples/records100/

# Model checkpoints: Track baseline weights (~1.7 MB total for zero-setup execution)
# Ignore ad-hoc or large export formats
*.onnx
*.pkl

# Generated evaluation artifacts (recreate with src/evaluation/score_guardrails.py)
artifacts/

# IDE settings & OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db
