# Virtual Environment (libraries installed on your machine)
.venv/
venv/
env/
.env

# Python compilation cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Local raw datasets & models (too big for GitHub)
data/raw/
data/ptbxl/
data/cohort/
data/samples/
models/checkpoints/
*.pt
*.onnx
*.joblib
*.pkl

# Generated evaluation artifacts (recreate with src/evaluation/score_guardrails.py)
artifacts/

# IDE settings & OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db

# Streamlit temporary state.
#
# `config.toml` is the exception and is tracked: it pins the light theme that
# src/dashboard/styles.css is built against. Without it the reader renders dark
# widgets on a light page on any dark-mode machine. Git does not honour a
# negation inside an ignored directory, so the contents are ignored instead.
.streamlit/*
!.streamlit/config.toml